# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Binance Futures API
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com

# Trading Configuration
TRADING_MODE=dry_run
TRADE_AMOUNT_USDT=10
LIVE_MIN_USDT_RESERVE=20
MARGIN_TYPE=ISOLATED

# LLM Configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
ENABLE_LLM=false
LLM_CANDIDATE_PICK_COUNT=10

# Database Configuration
# SQLite (default)
DB_PATH=./charon-binance.sqlite

# PostgreSQL (optional - set USE_POSTGRES=true to enable)
USE_POSTGRES=false
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=endelif
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_POOL_MAX=20

# Intervals
POSITION_CHECK_MS=10000
SIGNAL_SCAN_MS=30000

# Watchlist
WATCHLIST=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT

# Top Gainer Auto-Screening
TOP_GAINER_ENABLED=false
TOP_GAINER_COUNT=50
TOP_GAINER_MIN_VOLUME_USDT=50000000
TOP_GAINER_REFRESH_MS=300000
