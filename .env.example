# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Binance Futures API
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com

# Trading Configuration
TRADING_MODE=dry_run            # dry_run | confirm | live
TRADE_AMOUNT_USDT=10            # fallback margin only if the balance lookup fails
LIVE_MIN_USDT_RESERVE=20        # live: refuse entries below this available balance
MARGIN_TYPE=ISOLATED            # ISOLATED | CROSSED

# Risk (src/pipeline/positionSizing.js, riskControls.js, portfolioGates.js)
RISK_PERCENT_PER_TRADE=1        # % of available balance lost if the SL is hit (leverage-independent)
MAX_MARGIN_PERCENT_PER_TRADE=50 # cap margin per trade at this % of balance (tight SLs are clamped, not rejected)
DAILY_LOSS_LIMIT_PERCENT=3      # stop new entries at -3% realized vs start-of-day balance, until 00:00 UTC (07:00 WIB)
MAX_SAME_DIRECTION_POSITIONS=2  # max open positions per direction (LONG / SHORT)

# Kline continuity — same rule live and backtest (src/signals/klineCache.js classifyGaps)
KLINE_STRICT_CONTINUITY_CANDLES=20  # last N candles per timeframe must be continuous, no exceptions;
                                    # older holes are accepted only if Binance confirms it has no candles there

# Fill simulation — ONE cost model for dry-run and backtest (src/execution/simulation.js)
SIM_SLIPPAGE_PERCENT=0.03       # adverse slippage per side (entry and exit)
SIM_TAKER_FEE_PERCENT=0.05      # taker fee per side

# Backtest
BACKTEST_CACHE_DIR=.cache/klines  # on-disk kline cache; only missing days are downloaded

# LLM Configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
ENABLE_LLM=false                # code default: true. Allows LLM calls at all (decision path and shadow mode)
LLM_DECISION_ENABLED=false      # LLM decides trades only if true AND the strategy has use_llm: true
                                # (shadow mode is a strategy setting: /stratset <id> llm_shadow true)
LLM_CANDIDATE_PICK_COUNT=10

# Database (PostgreSQL is always used)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=endelif
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_POOL_MAX=20
# Legacy: DB_PATH is no longer read; USE_POSTGRES is only read by view_performance.js
DB_PATH=./charon-binance.sqlite
USE_POSTGRES=false

# Intervals
POSITION_CHECK_MS=10000
SIGNAL_SCAN_MS=30000

# Watchlist (env fallback when the DB watchlist is empty)
WATCHLIST=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT

# Top Gainer Auto-Screening
TOP_GAINER_ENABLED=false        # code default: true
TOP_GAINER_COUNT=50
TOP_GAINER_MIN_VOLUME_USDT=50000000
TOP_GAINER_REFRESH_MS=300000
