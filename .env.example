# Charon Binance Futures

# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance Futures (USDM Perpetual)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com

# Testnet (uncomment untuk testing):
# BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com
# BINANCE_FUTURES_WS_URL=wss://stream.binancefuture.com

# Trading mode: dry_run | confirm | live
TRADING_MODE=dry_run

# Jumlah USDT margin per trade
TRADE_AMOUNT_USDT=10

# Minimum free margin yang harus tersisa setelah buy
LIVE_MIN_USDT_RESERVE=20

# Margin type: ISOLATED | CROSSED
MARGIN_TYPE=ISOLATED

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
ENABLE_LLM=true
LLM_CANDIDATE_PICK_COUNT=10

# Polling intervals (ms)
POSITION_CHECK_MS=10000
SIGNAL_SCAN_MS=30000

# Comma-separated USDM symbols to watch
WATCHLIST=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT
